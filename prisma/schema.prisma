  slug        String    @unique
  nameAr      String
  nameEn      String
  description String?
  logoUrl     String?
  isVisible   Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ProductSimilar {
