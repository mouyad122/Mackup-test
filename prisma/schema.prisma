  code              String              @unique
  location          String?
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  inventories       Inventory[]
  movements         InventoryMovement[]
  outboundTransfers StockTransfer[]     @relation("TransferFromWarehouse")
  inboundTransfers  StockTransfer[]     @relation("TransferToWarehouse")
}

model Inventory {
