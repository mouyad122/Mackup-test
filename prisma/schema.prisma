generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model Employee {
  id                                                                         String                  @id @default(uuid())
  email                                                                      String                  @unique
  name                                                                       String
  passwordHash                                                               String
  isActive                                                                   Boolean                 @default(true)
  roleId                                                                     String
  createdAt                                                                  DateTime                @default(now())
  updatedAt                                                                  DateTime                @updatedAt
  failedAttempts                                                             Int                     @default(0)
  lockoutUntil                                                               DateTime?
  bootstrapCredential                                                        Boolean                 @default(false)
  mustChangePassword                                                         Boolean                 @default(false)
  pinHash                                                                    String?
  mfaEnabled                                                                 Boolean                 @default(false)
  mfaRecoveryCodes                                                           String?
  mfaSecret                                                                  String?
  auditLogs                                                                  AuditLog[]
  role                                                                       Role                    @relation(fields: [roleId], references: [id])
  permissions                                                                EmployeePermission[]
  heldSales                                                                  HeldSale[]
  InventoryCountSession_InventoryCountSession_approvedByEmployeeIdToEmployee InventoryCountSession[] @relation("InventoryCountSession_approvedByEmployeeIdToEmployee")
  InventoryCountSession_InventoryCountSession_assignedByEmployeeIdToEmployee InventoryCountSession[] @relation("InventoryCountSession_assignedByEmployeeIdToEmployee")
  InventoryCountSession_InventoryCountSession_assignedEmployeeIdToEmployee   InventoryCountSession[] @relation("InventoryCountSession_assignedEmployeeIdToEmployee")
  InventoryCountSession_InventoryCountSession_reviewedByEmployeeIdToEmployee InventoryCountSession[] @relation("InventoryCountSession_reviewedByEmployeeIdToEmployee")
  inventoryMoves                                                             InventoryMovement[]
  loginAttempts                                                              LoginAttempt[]
  ProductLiquidMovement                                                      ProductLiquidMovement[]
  ProductLiquidStock                                                         ProductLiquidStock[]
  returns                                                                    Return[]
  sales                                                                      Sale[]
  soldSales                                                                  Sale[]                  @relation("SoldSales")
  sessions                                                                   Session[]
  shifts                                                                     Shift[]
  pendingMfaChallenge                                                        PendingMfaChallenge?
  importJobs                                                                 ImportJob[]
  payAgreements                                                              EmployeePayAgreement[]  @relation("EmployeeAgreements")
  payrollPeriods                                                             PayrollPeriod[]         @relation("EmployeePayrollPeriods")
}

model EmployeePermission {
  employeeId          String
  permissionId        String
  createdAt           DateTime   @default(now())
  effect              String     @default("ALLOW")
  expiresAt           DateTime?
  grantedByEmployeeId String
  reason              String?
  updatedAt           DateTime   @updatedAt
  employee            Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  permission          Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([employeeId, permissionId])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  employees   Employee[]
  permissions RolePermission[]
}

model Permission {
  id          String               @id @default(uuid())
  action      String               @unique
  description String?
  employees   EmployeePermission[]
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id             String   @id
  employeeId     String
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
  id         String    @id @default(uuid())
  email      String
  ipAddress  String?
  userAgent  String?
  success    Boolean
  employeeId String?
  createdAt  DateTime  @default(now())
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Product {
  id                    String                  @id @default(uuid())
  slug                  String                  @unique
  nameAr                String
  nameEn                String
  sku                   String                  @unique
  shortDescription      String?
  longDescription       String?
  categoryId            String
  collectionId          String?
  genderId              String?
  seasonId              String?
  familyId              String?
  brandId               String?
  barcode               String?                 @unique
  productType           String?
  productTemplateId     String?
  isBestSeller          Boolean                 @default(false)
  isNew                 Boolean                 @default(false)
  isTrending            Boolean                 @default(false)
  tags                  String?
  ingredients           String?
  howToUse              String?
  warnings              String?
  finish                String?
  coverage              String?
  skinType              String?
  benefits              String?
  isVisible             Boolean                 @default(true)
  isFeatured            Boolean                 @default(false)
  featuredOrder         Int                     @default(0)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  needsReview           Boolean                 @default(false)
  reviewReasons         String?
  stockStatus           String                  @default("UNVERIFIED")
  inventoryMode         String                  @default("FINISHED_PRODUCT")
  notesStatus           String                  @default("VERIFIED")
  InventoryCountLine    InventoryCountLine[]
  orderItems            OrderItem[]
  category              Category                @relation(fields: [categoryId], references: [id])
  Collection            Collection?             @relation(fields: [collectionId], references: [id])
  FragranceFamily       FragranceFamily?        @relation(fields: [familyId], references: [id])
  Gender                Gender?                 @relation(fields: [genderId], references: [id])
  Season                Season?                 @relation(fields: [seasonId], references: [id])
  ProductAccord         ProductAccord[]
  ProductFormula        ProductFormula[]
  images                ProductImage[]
  ProductLiquidMovement ProductLiquidMovement[]
  ProductLiquidStock    ProductLiquidStock?
  ProductNote           ProductNote[]
  variants              ProductVariant[]
  brand                 Brand?                  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  reviews               Review[]
  ingredientsRelations  ProductIngredient[]
  similarProducts       ProductSimilar[]        @relation("ProductSimilars")
  similarOf             ProductSimilar[]        @relation("SimilarOf")
  slides                HomepageHeroSlide[]
  productTemplate       ProductTemplate?         @relation(fields: [productTemplateId], references: [id], onDelete: SetNull)
  attributeValues       ProductAttributeValue[]

  @@index([brandId])
  @@index([productTemplateId])
}

model ProductVariant {
  id                 String              @id @default(uuid())
  productId          String
  size               String
  name               String              @default("")
  barcode            String?             @unique
  colorName          String?
  colorHex           String?
  mainImage          String?
  swatchImage        String?
  modelImage         String?
  shadeId            String?
  sku                String              @unique
  price              Int
  compareAt          Int?
  stock              Int                 @default(0)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  usesGlobalPricing  Boolean             @default(true)
  inventorySource    String              @default("INTERNAL")
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  returnItems        ReturnItem[]
  saleItems          SaleItem[]
  supplierOffers     SupplierOffer[]
  images             ProductImage[]
  inventoryRecords   Inventory[]
  purchaseOrderItems PurchaseOrderItem[]
  stockTransfers     StockTransfer[]
  shade              Shade?              @relation(fields: [shadeId], references: [id], onDelete: SetNull)
  attributeValues    ProductVariantAttributeValue[]
}

model ProductTemplate {
  id          String                 @id @default(uuid())
  code        String                 @unique
  nameAr      String
  nameEn      String?
  description String?
  isActive    Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  fields      ProductTemplateField[]
  products    Product[]
  categories  Category[]
}

model ProductAttributeDefinition {
  id             String                 @id @default(uuid())
  key            String                 @unique
  nameAr         String
  nameEn         String?
  inputType      String                 @default("TEXT")
  optionsJson    String?
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  templateFields ProductTemplateField[]
  productValues  ProductAttributeValue[]
  variantValues  ProductVariantAttributeValue[]
}

model ProductTemplateField {
  id                    String                     @id @default(uuid())
  templateId            String
  attributeDefinitionId String
  isRequired            Boolean                    @default(false)
  showOnProductPage     Boolean                    @default(true)
  isFilterable          Boolean                    @default(false)
  useAsVariant          Boolean                    @default(false)
  sortOrder             Int                        @default(0)
  template              ProductTemplate            @relation(fields: [templateId], references: [id], onDelete: Cascade)
  attributeDefinition   ProductAttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Restrict)

  @@unique([templateId, attributeDefinitionId])
  @@index([templateId, sortOrder])
}

model ProductAttributeValue {
  id                    String                     @id @default(uuid())
  productId             String
  attributeDefinitionId String
  valueJson             String
  product               Product                    @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeDefinition   ProductAttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Restrict)

  @@unique([productId, attributeDefinitionId])
  @@index([attributeDefinitionId])
}

model ProductVariantAttributeValue {
  id                    String                     @id @default(uuid())
  variantId             String
  attributeDefinitionId String
  valueJson             String
  variant               ProductVariant             @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeDefinition   ProductAttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Restrict)

  @@unique([variantId, attributeDefinitionId])
  @@index([attributeDefinitionId])
}

model Supplier {
  id               String               @id @default(uuid())
  name             String
  ownerName        String?
  phone            String?
  email            String?
  address          String?
  mapLocationUrl   String?
  notes            String?
  profitMargin     Float                @default(0)
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  offers           SupplierOffer[]
  settlements      SupplierSettlement[]
  purchaseOrders   PurchaseOrder[]
  supplierInvoices SupplierInvoice[]
  locations        SupplierLocation[]
  fulfillmentOrders FulfillmentOrder[]
  accessSessions   SupplierAccessSession[]
  pickupBatches    PickupBatch[]

  @@index([isActive, name])
}

model SupplierOffer {
  id                     String                      @id @default(uuid())
  supplierId             String
  variantId              String
  unitCost               Int
  supplierProfitShareBps Int                         @default(0)
  stock                  Int                         @default(0)
  supplierSku            String?
  isActive               Boolean                     @default(true)
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  inventoryMovements     SupplierInventoryMovement[]
  supplier               Supplier                    @relation(fields: [supplierId], references: [id])
  variant                ProductVariant              @relation(fields: [variantId], references: [id])

  @@unique([supplierId, variantId])
  @@index([variantId, isActive])
  @@index([supplierId, isActive])
}

model SupplierInventoryMovement {
  id              String        @id @default(uuid())
  supplierOfferId String
  quantityDelta   Int
  quantityBefore  Int
  quantityAfter   Int
  reason          String
  reference       String?
  actorEmployeeId String?
  createdAt       DateTime      @default(now())
  supplierOffer   SupplierOffer @relation(fields: [supplierOfferId], references: [id])

  @@index([supplierOfferId, createdAt])
}

model ProductImage {
  id        String          @id @default(uuid())
  productId String
  variantId String?
  url       String
  alt       String?
  type      String          @default("PRIMARY")
  isMain    Boolean         @default(false)
  order     Int             @default(0)
  createdAt DateTime        @default(now())
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
}

model Category {
  id                String              @id @default(uuid())
  slug              String              @unique
  name              String
  description       String?
  imagePath         String?
  parentId          String?
  sortOrder         Int                 @default(0)
  isVisible         Boolean             @default(true)
  defaultTemplateId String?
  parent            Category?           @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children          Category[]          @relation("CategoryHierarchy")
  defaultTemplate   ProductTemplate?    @relation(fields: [defaultTemplateId], references: [id], onDelete: SetNull)
  products          Product[]
  slides            HomepageHeroSlide[]

  @@index([parentId, sortOrder])
  @@index([defaultTemplateId])
}

model Order {
  id                       String                 @id @default(uuid())
  reference                String                 @unique
  customerName             String
  customerPhone            String
  customerId               String?
  deliveryBatchId          String?
  preparedByEmployeeName   String?
  status                   String
  totalAmount              Int
  shippingCost             Int
  notes                    String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  idempotencyKey           String?                @unique
  paymentStatus            String                 @default("UNPAID")
  actualDeliveryCost       Int?
  discountAmount           Int                    @default(0)
  couponDiscount           Int                    @default(0)
  rewardDiscount           Int                    @default(0)
  couponCodeSnapshot       String?
  rewardNameSnapshot       String?
  shippingZoneNameSnapshot String?
  couponRedemption         CouponRedemption?
  deliveryAssignment       DeliveryAssignment?
  financialTransactions    FinancialTransaction[]
  invoice                  Invoice?
  items                    OrderItem[]
  statusHistory            OrderStatusHistory[]
  rewardRedemptions        RewardRedemption[]
  customer                 Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  deliveryBatch            DeliveryBatch?         @relation(fields: [deliveryBatchId], references: [id], onDelete: SetNull)

  // Multi-vendor Fulfillment Layer
  fulfillmentStrategy      String?                @default("DIRECT_PICKUP")
  fulfillmentStatus        String?                @default("UNFULFILLED")
  customerWhatsAppSentAt   DateTime?
  hasAdjustment            Boolean                @default(false)
  previousTotalAmount      Int?
  adjustmentNotes          String?
  fulfillmentOrders        FulfillmentOrder[]
  deliveryJob              DeliveryJob?
  fulfillmentOutboxTasks   FulfillmentOutbox[]

  // Telegram Notifications Tracking & Outbox
  telegramStatus           String?                @default("PENDING")
  telegramSentAt           DateTime?
  telegramError            String?

  @@index([customerId])
  @@index([deliveryBatchId])
  @@index([fulfillmentStatus])
  @@index([telegramStatus])
}

model OrderItem {
  id                             String  @id @default(uuid())
  orderId                        String
  productId                      String
  variantId                      String
  sku                            String
  name                           String
  size                           String
  quantity                       Int
  unitPrice                      Int
  total                          Int
  supplierIdSnapshot             String?
  supplierOfferIdSnapshot        String?
  supplierNameSnapshot           String?
  unitCostSnapshot               Int?
  supplierProfitShareBpsSnapshot Int?
  supplierAmountSnapshot         Int?
  platformProductProfitSnapshot  Int?
  discountAmountSnapshot         Int     @default(0)
  isRemoved                      Boolean @default(false)
  removalReason                  String?
  missingQuantity                Int     @default(0)
  order                          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product                        Product @relation(fields: [productId], references: [id])
  fulfillmentItems               FulfillmentItem[]
}

model OrderStatusHistory {
  id        String   @id @default(uuid())
  orderId   String
  status    String
  notes     String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Sale {
  id                         String                 @id @default(uuid())
  reference                  String                 @unique
  employeeId                 String
  customerName               String?                @default("عميل نقدي")
  customerId                 String?
  idempotencyKey             String?                @unique
  subtotal                   Int
  tax                        Int
  discount                   Int                    @default(0)
  total                      Int
  status                     String
  source                     String                 @default("POS")
  createdAt                  DateTime               @default(now())
  completedAt                DateTime?
  saleSource                 String                 @default("POS")
  sellerEmailSnapshot        String?
  sellerEmployeeCodeSnapshot String?
  sellerNameSnapshot         String?
  sellerRoleSnapshot         String?
  sessionId                  String?
  shiftId                    String?
  soldByEmployeeId           String?
  terminalId                 String?
  financialTransactions      FinancialTransaction[]
  invoice                    Invoice?
  payments                   Payment[]
  returns                    Return[]
  employee                   Employee               @relation(fields: [employeeId], references: [id])
  soldBy                     Employee?              @relation("SoldSales", fields: [soldByEmployeeId], references: [id])
  items                      SaleItem[]
  customer                   Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([customerId])
}

model SaleItem {
  id                             String         @id @default(uuid())
  saleId                         String
  variantId                      String
  sku                            String
  name                           String
  size                           String
  quantity                       Int
  unitPrice                      Int
  total                          Int
  discountAmountSnapshot         Int            @default(0)
  supplierOfferIdSnapshot        String?
  supplierIdSnapshot             String?
  supplierNameSnapshot           String?
  unitCostSnapshot               Int?
  supplierProfitShareBpsSnapshot Int?
  supplierAmountSnapshot         Int?
  platformProductProfitSnapshot  Int?
  sale                           Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant                        ProductVariant @relation(fields: [variantId], references: [id])
}

model Payment {
  id             String   @id @default(uuid())
  saleId         String
  method         String
  amount         Int
  amountTendered Int?
  createdAt      DateTime @default(now())
  terminalRef    String?
  sale           Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model Invoice {
  id                       String   @id @default(uuid())
  saleId                   String?  @unique
  number                   String   @unique
  secureToken              String?  @unique
  taxId                    String?
  printed                  Int      @default(0)
  createdAt                DateTime @default(now())
  orderId                  String?  @unique
  confirmedByEmployeeId    String?
  paymentStatus            String   @default("UNPAID")
  pricesIncludeTaxSnapshot Boolean  @default(true)
  taxModeSnapshot          String   @default("DISABLED")
  taxRateSnapshot          Float    @default(0.0)
  cardAppliedFils          Int      @default(0)
  cashAppliedFils          Int      @default(0)
  cashTenderedFils         Int      @default(0)
  changeDueFils            Int      @default(0)
  discountAmountFils       Int      @default(0)
  grossTotalFils           Int      @default(0)
  netSubtotalFils          Int      @default(0)
  shippingAmountFils       Int      @default(0)
  taxAmountFils            Int      @default(0)
  cashierNameSnapshot      String?
  cashierRoleSnapshot      String?
  refundAmountFils         Int      @default(0)
  order                    Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sale                     Sale?    @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model Return {
  id          String       @id @default(uuid())
  saleId      String
  employeeId  String
  reason      String?
  totalAmount Int
  createdAt   DateTime     @default(now())
  employee    Employee     @relation(fields: [employeeId], references: [id])
  sale        Sale         @relation(fields: [saleId], references: [id])
  items       ReturnItem[]
}

model ReturnItem {
  id        String         @id @default(uuid())
  returnId  String
  variantId String
  quantity  Int
  amount    Int
  return    Return         @relation(fields: [returnId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])
}

model InventoryMovement {
  id             String     @id @default(uuid())
  sku            String
  type           String
  quantity       Int
  quantityBefore Int        @default(0)
  quantityAfter  Int        @default(0)
  warehouseId    String?
  employeeId     String
  reference      String?
  createdAt      DateTime   @default(now())
  employee       Employee   @relation(fields: [employeeId], references: [id])
  warehouse      Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
}

model StockAdjustment {
  id        String   @id @default(uuid())
  sku       String
  oldStock  Int
  newStock  Int
  reason    String
  createdAt DateTime @default(now())
}

model AuditLog {
  id                String    @id @default(uuid())
  employeeId        String?
  action            String
  entityType        String
  entityId          String
  details           String?
  ipAddress         String?
  createdAt         DateTime  @default(now())

  // حقول مركز رَواق للتدقيق والرقابة (RAWAQ Audit & Security Center)
  actorType         String?   @default("SYSTEM") // ADMIN, SUPPLIER, COURIER, SYSTEM, ANONYMOUS
  actorId           String?
  actorNameSnapshot String?
  category          String?   @default("SECURITY") // ORDERS, SUPPLIERS, DELIVERY, ACCOUNTING, REPORTS, PRODUCTS, SECURITY
  severity          String?   @default("NORMAL")   // NORMAL, HIGH, CRITICAL
  outcome           String?   @default("SUCCESS")  // SUCCESS, FAILED, DENIED
  eventKey          String?
  requestId         String?
  correlationId     String?   // رقم الطلب، الفاتورة، أو التسوية لربط سلسلة الأحداث
  changes           String?   // JSON موحد ومنقى من الحقول الحساسة
  reason            String?

  employee          Employee? @relation(fields: [employeeId], references: [id])

  @@index([createdAt])
  @@index([category])
  @@index([severity])
  @@index([outcome])
  @@index([correlationId])
  @@index([entityId])
  @@index([actorId])
  @@index([action])
}

model SiteSettings {
  key   String @id
  value String
}

model GlobalPricingSettings {
  id               String  @id @default("1")
  taxRate          Float   @default(0.0)
  currencyCode     String  @default("JOD")
  currencySymbol   String  @default("د.أ")
  pricesIncludeTax Boolean @default(true)
  taxEnabled       Boolean @default(false)
}

model ShippingZone {
  id                    String  @id @default(uuid())
  nameAr                String
  nameEn                String
  fee                   Int
  estimatedDeliveryTime String
  isEnabled             Boolean @default(true)
  freeShippingThreshold Int?
  actualDeliveryCost    Int?
  captainEarning        Int?
}

model RewardRule {
  id            String             @id @default(uuid())
  name          String
  minimumAmount Int
  rewardType    String
  rewardValue   Int                @default(0)
  isActive      Boolean            @default(true)
  startsAt      DateTime?
  endsAt        DateTime?
  usageLimit    Int?
  usageCount    Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  priority      Int                @default(0)
  redemptions   RewardRedemption[]

  @@index([isActive, minimumAmount])
}

model Coupon {
  id                 String             @id @default(uuid())
  code               String             @unique
  name               String?
  discountType       String
  discountValue      Int                @default(0)
  minimumOrderAmount Int                @default(0)
  maximumDiscount    Int?
  startsAt           DateTime?
  endsAt             DateTime?
  usageLimit         Int?
  perCustomerLimit   Int?
  usageCount         Int                @default(0)
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  redemptions        CouponRedemption[]
  targets            CouponTarget[]

  @@index([isActive, startsAt, endsAt])
}

model CouponTarget {
  id         String @id @default(uuid())
  couponId   String
  targetType String
  targetId   String
  coupon     Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, targetType, targetId])
  @@index([targetType, targetId])
}

model CouponRedemption {
  id          String   @id @default(uuid())
  couponId    String
  orderId     String   @unique
  customerKey String
  amount      Int
  isVoided    Boolean  @default(false)
  createdAt   DateTime @default(now())
  coupon      Coupon   @relation(fields: [couponId], references: [id])
  order       Order    @relation(fields: [orderId], references: [id])

  @@index([couponId, customerKey])
}

model RewardRedemption {
  id           String     @id @default(uuid())
  rewardRuleId String
  orderId      String
  amount       Int        @default(0)
  isVoided     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  order        Order      @relation(fields: [orderId], references: [id])
  rewardRule   RewardRule @relation(fields: [rewardRuleId], references: [id])

  @@unique([rewardRuleId, orderId])
  @@index([rewardRuleId, isVoided])
}

model Captain {
  id          String               @id @default(uuid())
  name        String
  phone       String               @unique
  status      String               @default("AVAILABLE")
  isActive    Boolean              @default(true)
  notes       String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  settlements CaptainSettlement[]
  assignments DeliveryAssignment[]
}

model DeliveryAssignment {
  id                    String                 @id @default(uuid())
  orderId               String                 @unique
  captainId             String
  status                String                 @default("ASSIGNED")
  captainEarning        Int
  customerDeliveryFee   Int
  actualCarrierCost     Int?
  assignedByEmployeeId  String?
  deliveredAt           DateTime?
  notes                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  captain               Captain                @relation(fields: [captainId], references: [id])
  order                 Order                  @relation(fields: [orderId], references: [id])
  financialTransactions FinancialTransaction[]

  @@index([captainId, status])
}

model SupplierSettlement {
  id                  String   @id @default(uuid())
  supplierId          String
  amount              Int
  paymentMethod       String
  reference           String?
  notes               String?
  createdByEmployeeId String?
  createdAt           DateTime @default(now())
  supplier            Supplier @relation(fields: [supplierId], references: [id])

  @@index([supplierId, createdAt])
}

model CaptainSettlement {
  id                  String   @id @default(uuid())
  captainId           String
  amount              Int
  paymentMethod       String
  reference           String?
  notes               String?
  createdByEmployeeId String?
  createdAt           DateTime @default(now())
  captain             Captain  @relation(fields: [captainId], references: [id])

  @@index([captainId, createdAt])
}

model FinancialTransaction {
  id                   String              @id @default(uuid())
  type                 String
  direction            String
  amount               Int
  orderId              String?
  saleId               String?
  supplierId           String?
  captainId            String?
  deliveryAssignmentId String?
  description          String
