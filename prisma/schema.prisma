  name        String        @unique
  RawMaterial RawMaterial[]
}

model RawMaterialMovement {
  id          String      @id
  materialId  String
  type        String
  quantity    Float
  reference   String?
  notes       String?
  createdAt   DateTime    @default(now())
  RawMaterial RawMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
