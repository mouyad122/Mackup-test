// These catalog and ERP records are additive to the original perfume-focused
// schema.  Existing nullable foreign keys keep historical orders and products
// valid while the newer administration screens can use the richer relations.
model PendingMfaChallenge {
  id         String   @id @default(uuid())
  employeeId String   @unique
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Brand {
