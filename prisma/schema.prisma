generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model Employee {
  id                                                                         String                  @id @default(uuid())
  email                                                                      String                  @unique
  name                                                                       String
  passwordHash                                                               String
  isActive                                                                   Boolean                 @default(true)
  roleId                                                                     String
  createdAt                                                                  DateTime                @default(now())
  updatedAt                                                                  DateTime                @updatedAt
  failedAttempts                                                             Int                     @default(0)
  lockoutUntil                                                               DateTime?
  bootstrapCredential                                                        Boolean                 @default(false)
  mustChangePassword                                                         Boolean                 @default(false)
  pinHash                                                                    String?
  mfaEnabled                                                                 Boolean                 @default(false)
  mfaRecoveryCodes                                                           String?
  mfaSecret                                                                  String?
  auditLogs                                                                  AuditLog[]
  role                                                                       Role                    @relation(fields: [roleId], references: [id])
  permissions                                                                EmployeePermission[]
  heldSales                                                                  HeldSale[]
  InventoryCountSession_InventoryCountSession_approvedByEmployeeIdToEmployee InventoryCountSession[] @relation("InventoryCountSession_approvedByEmployeeIdToEmployee")
  InventoryCountSession_InventoryCountSession_assignedByEmployeeIdToEmployee InventoryCountSession[] @relation("InventoryCountSession_assignedByEmployeeIdToEmployee")
  InventoryCountSession_InventoryCountSession_assignedEmployeeIdToEmployee   InventoryCountSession[] @relation("InventoryCountSession_assignedEmployeeIdToEmployee")
  InventoryCountSession_InventoryCountSession_reviewedByEmployeeIdToEmployee InventoryCountSession[] @relation("InventoryCountSession_reviewedByEmployeeIdToEmployee")
  inventoryMoves                                                             InventoryMovement[]
  loginAttempts                                                              LoginAttempt[]
  ProductLiquidMovement                                                      ProductLiquidMovement[]
  ProductLiquidStock                                                         ProductLiquidStock[]
  returns                                                                    Return[]
  sales                                                                      Sale[]
  soldSales                                                                  Sale[]                  @relation("SoldSales")
  sessions                                                                   Session[]
  shifts                                                                     Shift[]
}

model EmployeePermission {
  employeeId          String
  permissionId        String
  createdAt           DateTime   @default(now())
  effect              String     @default("ALLOW")
  expiresAt           DateTime?
  grantedByEmployeeId String
  reason              String?
  updatedAt           DateTime   @updatedAt
  employee            Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  permission          Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([employeeId, permissionId])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  employees   Employee[]
  permissions RolePermission[]
}

model Permission {
  id          String               @id @default(uuid())
  action      String               @unique
  description String?
  employees   EmployeePermission[]
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id             String   @id
  employeeId     String
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
  id         String    @id @default(uuid())
  email      String
  ipAddress  String?
  userAgent  String?
  success    Boolean
  employeeId String?
  createdAt  DateTime  @default(now())
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Product {
  id                    String                  @id @default(uuid())
  slug                  String                  @unique
  nameAr                String
  nameEn                String
  sku                   String                  @unique
  shortDescription      String?
  longDescription       String?
  categoryId            String
  collectionId          String?
  genderId              String?
  seasonId              String?
  familyId              String?
  isVisible             Boolean                 @default(true)
  isFeatured            Boolean                 @default(false)
  featuredOrder         Int                     @default(0)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  needsReview           Boolean                 @default(false)
  reviewReasons         String?
  stockStatus           String                  @default("UNVERIFIED")
  inventoryMode         String                  @default("FINISHED_PRODUCT")
  notesStatus           String                  @default("VERIFIED")
  InventoryCountLine    InventoryCountLine[]
  orderItems            OrderItem[]
  category              Category                @relation(fields: [categoryId], references: [id])
  Collection            Collection?             @relation(fields: [collectionId], references: [id])
  FragranceFamily       FragranceFamily?        @relation(fields: [familyId], references: [id])
  Gender                Gender?                 @relation(fields: [genderId], references: [id])
  Season                Season?                 @relation(fields: [seasonId], references: [id])
  ProductAccord         ProductAccord[]
  ProductFormula        ProductFormula[]
  images                ProductImage[]
  ProductLiquidMovement ProductLiquidMovement[]
  ProductLiquidStock    ProductLiquidStock?
  ProductNote           ProductNote[]
  variants              ProductVariant[]
}

model ProductVariant {
  id                String          @id @default(uuid())
  productId         String
  size              String
  sku               String          @unique
  price             Int
  compareAt         Int?
  stock             Int             @default(0)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  usesGlobalPricing Boolean         @default(true)
  inventorySource   String          @default("INTERNAL")
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  returnItems       ReturnItem[]
  saleItems         SaleItem[]
  supplierOffers    SupplierOffer[]
}

model Supplier {
  id          String               @id @default(uuid())
  name        String
  phone       String?
  email       String?
  notes       String?
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  offers      SupplierOffer[]
  settlements SupplierSettlement[]

  @@index([isActive, name])
}

model SupplierOffer {
  id                     String                      @id @default(uuid())
  supplierId             String
  variantId              String
  unitCost               Int
  supplierProfitShareBps Int                         @default(0)
  stock                  Int                         @default(0)
  supplierSku            String?
  isActive               Boolean                     @default(true)
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  inventoryMovements     SupplierInventoryMovement[]
  supplier               Supplier                    @relation(fields: [supplierId], references: [id])
  variant                ProductVariant              @relation(fields: [variantId], references: [id])

  @@unique([supplierId, variantId])
  @@index([variantId, isActive])
  @@index([supplierId, isActive])
}

model SupplierInventoryMovement {
  id              String        @id @default(uuid())
  supplierOfferId String
  quantityDelta   Int
  quantityBefore  Int
  quantityAfter   Int
  reason          String
  reference       String?
  actorEmployeeId String?
  createdAt       DateTime      @default(now())
  supplierOffer   SupplierOffer @relation(fields: [supplierOfferId], references: [id])

  @@index([supplierOfferId, createdAt])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  alt       String?
  isMain    Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Category {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String
  description String?
  products    Product[]
}

model Order {
  id                       String                 @id @default(uuid())
  reference                String                 @unique
  customerName             String
  customerPhone            String
  status                   String
  totalAmount              Int
  shippingCost             Int
  notes                    String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  idempotencyKey           String?                @unique
  paymentStatus            String                 @default("UNPAID")
  actualDeliveryCost       Int?
  discountAmount           Int                    @default(0)
  couponDiscount           Int                    @default(0)
  rewardDiscount           Int                    @default(0)
  couponCodeSnapshot       String?
  rewardNameSnapshot       String?
  shippingZoneNameSnapshot String?
  couponRedemption         CouponRedemption?
  deliveryAssignment       DeliveryAssignment?
  financialTransactions    FinancialTransaction[]
  invoice                  Invoice?
  items                    OrderItem[]
  statusHistory            OrderStatusHistory[]
  rewardRedemptions        RewardRedemption[]
}

model OrderItem {
  id                             String  @id @default(uuid())
  orderId                        String
  productId                      String
  variantId                      String
  sku                            String
  name                           String
  size                           String
  quantity                       Int
  unitPrice                      Int
  total                          Int
  supplierIdSnapshot             String?
  supplierOfferIdSnapshot        String?
  supplierNameSnapshot           String?
  unitCostSnapshot               Int?
  supplierProfitShareBpsSnapshot Int?
  supplierAmountSnapshot         Int?
  platformProductProfitSnapshot  Int?
  discountAmountSnapshot         Int     @default(0)
  order                          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product                        Product @relation(fields: [productId], references: [id])
}

model OrderStatusHistory {
  id        String   @id @default(uuid())
  orderId   String
  status    String
  notes     String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Sale {
  id                         String                 @id @default(uuid())
  reference                  String                 @unique
  employeeId                 String
  customerName               String?                @default("عميل نقدي")
  subtotal                   Int
  tax                        Int
  discount                   Int                    @default(0)
  total                      Int
  status                     String
  source                     String                 @default("POS")
  createdAt                  DateTime               @default(now())
  completedAt                DateTime?
  saleSource                 String                 @default("POS")
  sellerEmailSnapshot        String?
  sellerEmployeeCodeSnapshot String?
  sellerNameSnapshot         String?
  sellerRoleSnapshot         String?
  sessionId                  String?
  shiftId                    String?
  soldByEmployeeId           String?
  terminalId                 String?
  financialTransactions      FinancialTransaction[]
  invoice                    Invoice?
  payments                   Payment[]
  returns                    Return[]
  employee                   Employee               @relation(fields: [employeeId], references: [id])
  soldBy                     Employee?              @relation("SoldSales", fields: [soldByEmployeeId], references: [id])
  items                      SaleItem[]
}

model SaleItem {
  id                             String         @id @default(uuid())
  saleId                         String
  variantId                      String
  sku                            String
  name                           String
  size                           String
  quantity                       Int
  unitPrice                      Int
  total                          Int
  discountAmountSnapshot         Int            @default(0)
  supplierOfferIdSnapshot        String?
  supplierIdSnapshot             String?
  supplierNameSnapshot           String?
  unitCostSnapshot               Int?
  supplierProfitShareBpsSnapshot Int?
  supplierAmountSnapshot         Int?
  platformProductProfitSnapshot  Int?
  sale                           Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant                        ProductVariant @relation(fields: [variantId], references: [id])
}

model Payment {
  id             String   @id @default(uuid())
  saleId         String
  method         String
  amount         Int
  amountTendered Int?
  createdAt      DateTime @default(now())
  terminalRef    String?
  sale           Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model Invoice {
  id                       String   @id @default(uuid())
  saleId                   String?  @unique
  number                   String   @unique
  taxId                    String?
  printed                  Int      @default(0)
  createdAt                DateTime @default(now())
  orderId                  String?  @unique
  confirmedByEmployeeId    String?
  paymentStatus            String   @default("UNPAID")
  pricesIncludeTaxSnapshot Boolean  @default(true)
  taxModeSnapshot          String   @default("DISABLED")
  taxRateSnapshot          Float    @default(0.0)
  cardAppliedFils          Int      @default(0)
  cashAppliedFils          Int      @default(0)
  cashTenderedFils         Int      @default(0)
  changeDueFils            Int      @default(0)
  discountAmountFils       Int      @default(0)
  grossTotalFils           Int      @default(0)
  netSubtotalFils          Int      @default(0)
  shippingAmountFils       Int      @default(0)
  taxAmountFils            Int      @default(0)
  cashierNameSnapshot      String?
  cashierRoleSnapshot      String?
  refundAmountFils         Int      @default(0)
  order                    Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sale                     Sale?    @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model Return {
  id          String       @id @default(uuid())
  saleId      String
  employeeId  String
  reason      String?
  totalAmount Int
  createdAt   DateTime     @default(now())
  employee    Employee     @relation(fields: [employeeId], references: [id])
  sale        Sale         @relation(fields: [saleId], references: [id])
  items       ReturnItem[]
}

model ReturnItem {
  id        String         @id @default(uuid())
  returnId  String
  variantId String
  quantity  Int
  amount    Int
  return    Return         @relation(fields: [returnId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])
}

model InventoryMovement {
  id         String   @id @default(uuid())
  sku        String
  type       String
  quantity   Int
  employeeId String
  reference  String?
  createdAt  DateTime @default(now())
  employee   Employee @relation(fields: [employeeId], references: [id])
}

model StockAdjustment {
  id        String   @id @default(uuid())
  sku       String
  oldStock  Int
  newStock  Int
  reason    String
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String    @id @default(uuid())
  employeeId String?
  action     String
  entityType String
  entityId   String
  details    String?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  employee   Employee? @relation(fields: [employeeId], references: [id])
}

model SiteSettings {
  key   String @id
  value String
}

model GlobalPricingSettings {
  id               String  @id @default("1")
  taxRate          Float   @default(0.0)
  currencyCode     String  @default("JOD")
  currencySymbol   String  @default("د.أ")
  pricesIncludeTax Boolean @default(true)
  taxEnabled       Boolean @default(false)
}

model ShippingZone {
  id                    String  @id @default(uuid())
  nameAr                String
  nameEn                String
  fee                   Int
  estimatedDeliveryTime String
  isEnabled             Boolean @default(true)
  freeShippingThreshold Int?
  actualDeliveryCost    Int?
  captainEarning        Int?
}

model RewardRule {
  id            String             @id @default(uuid())
  name          String
  minimumAmount Int
  rewardType    String
  rewardValue   Int                @default(0)
  isActive      Boolean            @default(true)
  startsAt      DateTime?
  endsAt        DateTime?
  usageLimit    Int?
  usageCount    Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  priority      Int                @default(0)
  redemptions   RewardRedemption[]

  @@index([isActive, minimumAmount])
}

model Coupon {
  id                 String             @id @default(uuid())
  code               String             @unique
  name               String?
  discountType       String
  discountValue      Int                @default(0)
  minimumOrderAmount Int                @default(0)
  maximumDiscount    Int?
  startsAt           DateTime?
  endsAt             DateTime?
  usageLimit         Int?
  perCustomerLimit   Int?
  usageCount         Int                @default(0)
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  redemptions        CouponRedemption[]
  targets            CouponTarget[]

  @@index([isActive, startsAt, endsAt])
}

model CouponTarget {
  id         String @id @default(uuid())
  couponId   String
  targetType String
  targetId   String
  coupon     Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, targetType, targetId])
  @@index([targetType, targetId])
}

model CouponRedemption {
  id          String   @id @default(uuid())
  couponId    String
  orderId     String   @unique
  customerKey String
  amount      Int
  isVoided    Boolean  @default(false)
  createdAt   DateTime @default(now())
  coupon      Coupon   @relation(fields: [couponId], references: [id])
  order       Order    @relation(fields: [orderId], references: [id])

  @@index([couponId, customerKey])
}

model RewardRedemption {
  id           String     @id @default(uuid())
  rewardRuleId String
  orderId      String
  amount       Int        @default(0)
  isVoided     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  order        Order      @relation(fields: [orderId], references: [id])
  rewardRule   RewardRule @relation(fields: [rewardRuleId], references: [id])

  @@unique([rewardRuleId, orderId])
  @@index([rewardRuleId, isVoided])
}

model Captain {
  id          String               @id @default(uuid())
  name        String
  phone       String               @unique
  status      String               @default("AVAILABLE")
  isActive    Boolean              @default(true)
  notes       String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  settlements CaptainSettlement[]
  assignments DeliveryAssignment[]
}

model DeliveryAssignment {
  id                    String                 @id @default(uuid())
  orderId               String                 @unique
  captainId             String
  status                String                 @default("ASSIGNED")
  captainEarning        Int
  customerDeliveryFee   Int
  actualCarrierCost     Int?
  assignedByEmployeeId  String?
  deliveredAt           DateTime?
  notes                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  captain               Captain                @relation(fields: [captainId], references: [id])
  order                 Order                  @relation(fields: [orderId], references: [id])
  financialTransactions FinancialTransaction[]

  @@index([captainId, status])
}

model SupplierSettlement {
  id                  String   @id @default(uuid())
  supplierId          String
  amount              Int
  paymentMethod       String
  reference           String?
  notes               String?
  createdByEmployeeId String?
  createdAt           DateTime @default(now())
  supplier            Supplier @relation(fields: [supplierId], references: [id])

  @@index([supplierId, createdAt])
}

model CaptainSettlement {
  id                  String   @id @default(uuid())
  captainId           String
  amount              Int
  paymentMethod       String
  reference           String?
  notes               String?
  createdByEmployeeId String?
  createdAt           DateTime @default(now())
  captain             Captain  @relation(fields: [captainId], references: [id])

  @@index([captainId, createdAt])
}

model FinancialTransaction {
  id                   String              @id @default(uuid())
  type                 String
  direction            String
  amount               Int
  orderId              String?
  saleId               String?
  supplierId           String?
  captainId            String?
  deliveryAssignmentId String?
  description          String
  createdByEmployeeId  String?
  createdAt            DateTime            @default(now())
  businessEventKey     String?             @unique
  expense              Expense?
  deliveryAssignment   DeliveryAssignment? @relation(fields: [deliveryAssignmentId], references: [id], onDelete: Restrict)
  order                Order?              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sale                 Sale?               @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@index([type, createdAt])
  @@index([supplierId, createdAt])
  @@index([captainId, createdAt])
  @@index([orderId, type])
  @@index([saleId])
}

model Expense {
  id                     String                @id @default(uuid())
  category               String
  amount                 Int
  expenseDate            DateTime              @default(now())
  description            String
  reference              String?
  createdByEmployeeId    String?
  financialTransactionId String?               @unique
  createdAt              DateTime              @default(now())
  financialTransaction   FinancialTransaction? @relation(fields: [financialTransactionId], references: [id], onDelete: Restrict)

  @@index([expenseDate, category])
}

model RateLimitEvent {
  id        String   @id @default(uuid())
  key       String
  route     String
  points    Int      @default(1)
  expireAt  DateTime
  createdAt DateTime @default(now())
}

model Shift {
  id                   String    @id @default(uuid())
  employeeId           String
  openingCashFils      Int
  expectedCashFils     Int?
  actualCashFils       Int?
  varianceFils         Int?
  cardRecordedFils     Int?
  refundFils           Int?
  status               String    @default("OPEN")
  notes                String?
  terminalId           String
  approvedByEmployeeId String?
  openedAt             DateTime  @default(now())
  closedAt             DateTime?
  employee             Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model HeldSale {
  id            String   @id @default(uuid())
  label         String
  customerName  String?
  customerPhone String?
  reason        String?
  employeeId    String
  cartData      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Accord {
  id            String          @id
  name          String          @unique
  color         String?
  ProductAccord ProductAccord[]
}

model Collection {
  id          String    @id
  slug        String    @unique
  name        String
  description String?
  image       String?
  Product     Product[]
}

model ConsumptionRecord {
  id          String      @id
  materialId  String
  quantity    Float
  saleId      String?
  createdAt   DateTime    @default(now())
  RawMaterial RawMaterial @relation(fields: [materialId], references: [id])
}

model FragranceFamily {
  id      String    @id
  name    String    @unique
  Product Product[]
}

model Gender {
  id      String    @id
  name    String    @unique
  Product Product[]
}

model InventoryCountLine {
  id                         String                @id
  countSessionId             String
  productId                  String
  inventoryMode              String
  expectedQuantityMlSnapshot Int
  countedQuantityMl          Int
  varianceMl                 Int
  expectedUnitsSnapshot      Int?
  countedUnits               Int?
  varianceUnits              Int?
  countStatus                String
  employeeNote               String?
  managerNote                String?
  countedAt                  DateTime?
  InventoryCountSession      InventoryCountSession @relation(fields: [countSessionId], references: [id], onDelete: Cascade)
  Product                    Product               @relation(fields: [productId], references: [id])
}

model InventoryCountSession {
  id                                                            String               @id
  reference                                                     String               @unique
  title                                                         String
  status                                                        String
  assignedEmployeeId                                            String
  assignedByEmployeeId                                          String
  reviewedByEmployeeId                                          String?
  approvedByEmployeeId                                          String?
  scopeType                                                     String
  startedAt                                                     DateTime?
  submittedAt                                                   DateTime?
  reviewedAt                                                    DateTime?
  approvedAt                                                    DateTime?
  notes                                                         String?
  createdAt                                                     DateTime             @default(now())
  updatedAt                                                     DateTime
  InventoryCountLine                                            InventoryCountLine[]
  Employee_InventoryCountSession_approvedByEmployeeIdToEmployee Employee?            @relation("InventoryCountSession_approvedByEmployeeIdToEmployee", fields: [approvedByEmployeeId], references: [id])
  Employee_InventoryCountSession_assignedByEmployeeIdToEmployee Employee             @relation("InventoryCountSession_assignedByEmployeeIdToEmployee", fields: [assignedByEmployeeId], references: [id])
  Employee_InventoryCountSession_assignedEmployeeIdToEmployee   Employee             @relation("InventoryCountSession_assignedEmployeeIdToEmployee", fields: [assignedEmployeeId], references: [id])
  Employee_InventoryCountSession_reviewedByEmployeeIdToEmployee Employee?            @relation("InventoryCountSession_reviewedByEmployeeIdToEmployee", fields: [reviewedByEmployeeId], references: [id])
}

model ProductAccord {
  productId String
  accordId  String
  value     Int
  order     Int     @default(0)
  Accord    Accord  @relation(fields: [accordId], references: [id], onDelete: Cascade)
  Product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, accordId])
}

model ProductFormula {
  id                 String               @id
  productId          String
  name               String
  size               String
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  Product            Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  ProductFormulaItem ProductFormulaItem[]
}

model ProductFormulaItem {
  id             String         @id
  formulaId      String
  materialId     String
  quantity       Float
  ProductFormula ProductFormula @relation(fields: [formulaId], references: [id], onDelete: Cascade)
  RawMaterial    RawMaterial    @relation(fields: [materialId], references: [id])
}

model ProductLiquidMovement {
  id               String   @id
  productId        String
  type             String
  quantityBeforeMl Int
  quantityChangeMl Int
  quantityAfterMl  Int
  relatedSaleId    String?
  relatedInvoiceId String?
  employeeId       String
  reason           String?
  idempotencyKey   String?  @unique
  createdAt        DateTime @default(now())
  Employee         Employee @relation(fields: [employeeId], references: [id])
  Product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductLiquidStock {
  productId                String    @id @unique
  quantityMl               Int       @default(0)
  lowStockThresholdMl      Int       @default(1000)
  verificationStatus       String    @default("UNVERIFIED")
  lastVerifiedAt           DateTime?
  lastVerifiedByEmployeeId String?
  version                  Int       @default(1)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime
  Employee                 Employee? @relation(fields: [lastVerifiedByEmployeeId], references: [id])
  Product                  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductNote {
  id           String  @id
  productId    String
  displayOrder Int     @default(0)
  nameAr       String
  nameEn       String
  noteType     String
  Product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model RawMaterial {
  id                  String                @id
  sku                 String                @unique
  name                String
  categoryId          String
  unit                String
  costPerUnit         Int
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  ConsumptionRecord   ConsumptionRecord[]
  ProductFormulaItem  ProductFormulaItem[]
  RawMaterialCategory RawMaterialCategory   @relation(fields: [categoryId], references: [id])
  RawMaterialMovement RawMaterialMovement[]
  RawMaterialStock    RawMaterialStock?
}

model RawMaterialCategory {
  id          String        @id
  name        String        @unique
  RawMaterial RawMaterial[]
}

model RawMaterialMovement {
  id          String      @id
  materialId  String
  type        String
  quantity    Float
  reference   String?
  notes       String?
  createdAt   DateTime    @default(now())
  RawMaterial RawMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
}

model RawMaterialStock {
  id           String      @id
  materialId   String      @unique
  quantity     Float
  minThreshold Float?
  lastUpdated  DateTime
  RawMaterial  RawMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
}

model Season {
  id      String    @id
  name    String    @unique
  Product Product[]
}
