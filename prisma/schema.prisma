  courierCompany String?
  courierName    String?
  courierPhone   String?
  secureToken    String?  @unique
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  orders         Order[]
}

model PurchaseOrder {
