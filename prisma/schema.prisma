  name    String    @unique
  Product Product[]
}

model InventoryCountLine {
  id                         String                @id
  countSessionId             String
  productId                  String
  inventoryMode              String
  expectedQuantityMlSnapshot Int
  countedQuantityMl          Int
  varianceMl                 Int
  expectedUnitsSnapshot      Int?
  countedUnits               Int?
  varianceUnits              Int?
  countStatus                String
  employeeNote               String?
  managerNote                String?
  countedAt                  DateTime?
  InventoryCountSession      InventoryCountSession @relation(fields: [countSessionId], references: [id], onDelete: Cascade)
  Product                    Product               @relation(fields: [productId], references: [id])
}

model InventoryCountSession {
  id                                                            String               @id
  reference                                                     String               @unique
  title                                                         String
  status                                                        String
  assignedEmployeeId                                            String
  assignedByEmployeeId                                          String
  reviewedByEmployeeId                                          String?
  approvedByEmployeeId                                          String?
  scopeType                                                     String
  startedAt                                                     DateTime?
  submittedAt                                                   DateTime?
  reviewedAt                                                    DateTime?
  approvedAt                                                    DateTime?
  notes                                                         String?
  createdAt                                                     DateTime             @default(now())
  updatedAt                                                     DateTime
  InventoryCountLine                                            InventoryCountLine[]
  Employee_InventoryCountSession_approvedByEmployeeIdToEmployee Employee?            @relation("InventoryCountSession_approvedByEmployeeIdToEmployee", fields: [approvedByEmployeeId], references: [id])
  Employee_InventoryCountSession_assignedByEmployeeIdToEmployee Employee             @relation("InventoryCountSession_assignedByEmployeeIdToEmployee", fields: [assignedByEmployeeId], references: [id])
  Employee_InventoryCountSession_assignedEmployeeIdToEmployee   Employee             @relation("InventoryCountSession_assignedEmployeeIdToEmployee", fields: [assignedEmployeeId], references: [id])
  Employee_InventoryCountSession_reviewedByEmployeeIdToEmployee Employee?            @relation("InventoryCountSession_reviewedByEmployeeIdToEmployee", fields: [reviewedByEmployeeId], references: [id])
}

model ProductAccord {
