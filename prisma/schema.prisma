  businessEventKey     String?             @unique
  expense              Expense?
  deliveryAssignment   DeliveryAssignment? @relation(fields: [deliveryAssignmentId], references: [id], onDelete: Restrict)
  order                Order?              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sale                 Sale?               @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@index([type, createdAt])
  @@index([supplierId, createdAt])
  @@index([captainId, createdAt])
  @@index([orderId, type])
  @@index([saleId])
}

model Expense {
  id                     String                @id @default(uuid())
  category               String
  amount                 Int
  expenseDate            DateTime              @default(now())
  description            String
  reference              String?
  createdByEmployeeId    String?
  financialTransactionId String?               @unique
  createdAt              DateTime              @default(now())
  financialTransaction   FinancialTransaction? @relation(fields: [financialTransactionId], references: [id], onDelete: Restrict)

  @@index([expenseDate, category])
