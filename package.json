{
  "name": "cosmetics-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=4096' next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "test": "pnpm test:migrate && node --env-file=.env node_modules/vitest/vitest.mjs run --pool=forks --fileParallelism=false",
    "test:migrate": "DATABASE_URL=postgres://postgres:postgres@localhost:51214/makeup_test?sslmode=disable DIRECT_URL=postgres://postgres:postgres@localhost:51214/makeup_test?sslmode=disable prisma migrate deploy",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "tsx --env-file=.env scripts/create-admin.ts",
    "import:products": "tsx --env-file=.env scripts/import-products.ts",
    "create:admin": "tsx --env-file=.env scripts/create-admin.ts",
    "test:concurrency": "node --env-file=.env node_modules/vitest/vitest.mjs run src/tests/concurrency-verification.test.ts",
    "db:safeguard": "tsx scripts/db-safeguard.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.2",
    "@types/pg": "^8.20.0",
    "argon2": "^0.44.0",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@neon/config": "^1.8.6",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "csv-parse": "^7.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "papaparse": "^5.5.4",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
